      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chauhan-legacy/Echo-Tsx.git"
  },
  "bugs": {
    "url": "https://github.com/Chauhan-legacy/Echo-Tsx/issues"
  },
  "homepage": "https://github.com/Chauhan-legacy/Echo-Tsx#readme",
  "keywords": [
    "dsp",
    "forensics",
    "kalman-filter",
    "music-doa",
    "fastica",
    "wavelets",
    "rppg",
    "enf-analysis",
    "machine-learning",
    "attention",
    "privacy"
  ],
