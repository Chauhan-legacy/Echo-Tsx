{
  "name": "echo-tsx",
  "version": "1.0.0",
  "description": "Echo-Tsx: High-assurance, zero-dependency mathematical signal processing, physical forensics, and client-side deep learning library in TypeScript.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
